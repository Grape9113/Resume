         <ExecutionAction ActionType="Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent title="Stop any running copy of Resume" scriptText="for pid in $(/usr/bin/pgrep -x Resume 2&gt;/dev/null); do&#10;  executable=$(/bin/ps -p &quot;$pid&quot; -o command=)&#10;  case &quot;$executable&quot; in&#10;    */Resume.app/Contents/MacOS/Resume) /bin/kill -TERM &quot;$pid&quot; 2&gt;/dev/null || true ;;&#10;  esac&#10;done&#10;/bin/sleep 0.3&#10;exit 0&#10;"/>
         </ExecutionAction>
